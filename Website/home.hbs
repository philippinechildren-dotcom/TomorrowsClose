{{!< default}}

{{#get "pages" filter="slug:home" limit="1"}}
{{#foreach pages}}

<header class="site-home-header outer">
    <div class="inner">
    </div>
</header>

<main id="site-main" class="site-main outer">
    <div class="inner">
        <article class="post-full">
            <section class="post-full-content">
                {{content}}
            </section>
        </article>
    </div>
</main>

{{/foreach}}
{{/get}}